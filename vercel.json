{
  "outputDirectory": "public",
  "rewrites": [{ "source": "/api/:path*", "destination": "/api/index?__path=:path*" }],
  "functions": { "api/index.js": { "includeFiles": "data/**", "maxDuration": 60 } },
  "crons": [
    { "path": "/api/alerts/run", "schedule": "10 0 * * *" },
    { "path": "/api/cron/daily", "schedule": "10 13 * * *" }
  ],
  "headers": [
    { "source": "/airports.min.json", "missing": [{ "type": "query", "key": "v" }], "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }] },
    { "source": "/logos/(.*)\\.webp", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }] },
    { "source": "/icon-(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }] },
    { "source": "/(.*)\\.(js|css)", "missing": [{ "type": "query", "key": "v" }], "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=86400" }] },
    { "source": "/(.*)\\.json", "has": [{ "type": "query", "key": "v" }], "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(.*)\\.(js|css)", "has": [{ "type": "query", "key": "v" }], "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'" }
    ] }
  ]
}
