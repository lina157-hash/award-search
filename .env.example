# seats.aero Partner API key（Pro 會員在帳號設定取得）。不要提交到 git。
SEATS_AERO_API_KEY=
PORT=3000
# 同樣查詢的快取秒數，節省每日 1000 次額度
CACHE_TTL_SECONDS=1800

# 選用：現金票即時價格（SerpApi 的 Google 航班資料，https://serpapi.com）。不要提交到 git。
SERPAPI_KEY=
# 選用：RapidAPI 金鑰（Google Flights 現金票優先、整月價格、誰飛直航、Booking.com 飯店現金價）。不要提交到 git。
RAPIDAPI_KEY=

# 選用：買機票分頁的通關密碼。設定後，要輸入密碼才會用 SerpApi 查即時票價（保護額度）。
CASH_PASSCODE=

# 選用：機位提醒。Upstash Redis（Vercel Storage → Marketplace 建立後自動帶入）與 Resend 寄信金鑰。
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# 選用：舊版 Vercel KV 的同一組連線設定（沒有上面兩個時才用）
KV_REST_API_URL=
KV_REST_API_TOKEN=
RESEND_API_KEY=
# 選用：Vercel cron 呼叫 /api/alerts/run 時帶的密鑰；自訂寄件人（需在 Resend 驗證網域）
CRON_SECRET=
ALERT_FROM=

# 選用：一句話搜尋（把一句中文變成搜尋條件，只有站長看得到）。ChatGPT（GPT-6 Luna）或 Claude（Haiku 5.5）擇一設定；
# 兩個都設時用 ChatGPT，NL_PROVIDER=claude 改用 Claude。都沒設定時輸入框不會出現。不要提交到 git。
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
NL_PROVIDER=
# 一句話搜尋每天（台灣時間）最多解析幾次，預設 100
NL_DAILY_LIMIT=

# 選用：網站網址（信件與通知裡的連結），例如 https://example.vercel.app；沒設定時用 Vercel 的正式網址
SITE_URL=
# 選用：Telegram 通知，@BotFather 給的機器人金鑰。不要提交到 git。
TELEGRAM_BOT_TOKEN=
# 選用：LINE 官方帳號（Messaging API）的 Channel access token 與 Channel secret，需要 Upstash Redis。不要提交到 git。
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# 選用：LINE 每月最多推播幾則，預設 180
LINE_MONTHLY_CAP=
# 選用：今日好康每日信最多幾人訂閱，預設 50
DEALS_DIGEST_MAX=
# 選用：帳號信（驗證、重設密碼）每天最多寄幾封，預設 30
ACCOUNT_MAILS_PER_DAY=
# 選用：訪客每天的獎勵機位查詢次數上限（每個 IP／全站合計），預設 150／700
SEATS_DAILY_PER_IP=
SEATS_DAILY_VISITORS=
# 選用：訪客每天的飯店點數查詢次數上限（每個 IP／全站合計），預設 150／700
ROOMS_DAILY_PER_IP=
ROOMS_DAILY_VISITORS=
# 選用：獎勵機位與飯店點數查詢結果在 Redis 共用快取的秒數，預設同 CACHE_TTL_SECONDS
SEARCH_CACHE_TTL_SECONDS=
# 選用：誰飛直航（AeroDataBox）每月可用單位，預設 400
DIRECTS_MONTHLY_UNITS=
# 選用：設為 1 時兌換地圖的「地圖樣式」多出 Stadia Maps 的樣式（簡潔、簡潔深色、水彩、黑白）。不需要金鑰，
# 但要先到 Stadia Maps 的 client dashboard（Manage Properties → Authentication Configuration）登記網站的網域，
# 否則圖磚會被拒絕（地圖會自動退回 OpenStreetMap 標準樣式）。免費方案限非商業使用。
MAP_STADIA=
# 選用：設為 1 時即使有 seats.aero 金鑰也用示範資料
MOCK=
# Vercel 會自動提供，不用設定：VERCEL_PROJECT_PRODUCTION_URL、VERCEL_GIT_COMMIT_SHA、VERCEL_GIT_REPO_OWNER、VERCEL_GIT_REPO_SLUG
