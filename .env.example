# seats.aero Partner API key（Pro 會員在帳號設定取得）。不要提交到 git。
SEATS_AERO_API_KEY=
PORT=3000
# 同樣查詢的快取秒數，節省每日 1000 次額度
CACHE_TTL_SECONDS=1800

# 選用：現金票即時價格（SerpApi 的 Google 航班資料，https://serpapi.com）。不要提交到 git。
SERPAPI_KEY=

# 選用：買機票分頁的通關密碼。設定後，要輸入密碼才會用 SerpApi 查即時票價（保護額度）。
CASH_PASSCODE=

# 選用：機位提醒。Upstash Redis（Vercel Storage → Marketplace 建立後自動帶入）與 Resend 寄信金鑰。
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RESEND_API_KEY=
# 選用：Vercel cron 呼叫 /api/alerts/run 時帶的密鑰；自訂寄件人（需在 Resend 驗證網域）
CRON_SECRET=
ALERT_FROM=

# 選用：一句話搜尋（Claude Haiku 5.5 把一句中文變成搜尋條件，只有站長看得到）。沒設定時輸入框不會出現。不要提交到 git。
ANTHROPIC_API_KEY=
# 一句話搜尋每天（台灣時間）最多解析幾次，預設 100
NL_DAILY_LIMIT=
